# Audio

# Bluetooth

# Camera
persist.vendor.camera.logLevel=0
persist.vendor.camera.sensor=0

# Chipset

# FS-verity
ro.apk_verity.mode=2

# Crypto

# DPM

# Enable DeviceAsWebcam support
ro.usb.uvc.enabled=true

# Fingerprint
persist.vendor.fingerprint.type=udfps_optical
persist.vendor.fingerprint.sensor_location=540|2149|103

# FUSE passthrough

# Gatekeeper

# Graphics
debug.egl.hw=0
debug.mdpcomp.logs=0
debug.sf.disable_client_composition_cache=1
debug.sf.hw=0
debug.sf.enable_egl_image_tracker=1
persist.sys.sf.color_saturation=1.0
ro.surface_flinger.game_default_frame_rate_override=120

# LMK
ro.config.low_ram=false

# Logs
persist.log.tag.QC2Buf=W
persist.log.tag.QC2V4l2Codec=E

# Media

# NFC

# Perf

# Radio
ro.telephony.block_binder_thread_on_incoming_calls=false

# Sensors

# Storage

# Thermal

# USB

# Wifi

# Zygote

# Haptic Feedback
sys.haptic.down=5,2
sys.haptic.down.normal=2
sys.haptic.down.strong=5
sys.haptic.down.weak=0
sys.haptic.flick=5,2
sys.haptic.flick.light=7,2
sys.haptic.hold=4,2
sys.haptic.infinitelevel=true
sys.haptic.long.press=0,1
sys.haptic.mesh.heavy=8,2
sys.haptic.mesh.light=5,1
sys.haptic.mesh.normal=5,2
sys.haptic.motor=linear
sys.haptic.pickup=2,2
sys.haptic.popup.light=6,1
sys.haptic.popup.normal=6,2
sys.haptic.runin=13
sys.haptic.scroll.edge=7,0
sys.haptic.switch=9,2
sys.haptic.tap.light=5,2
sys.haptic.tap.normal=3,2
sys.haptic.trigger.drawer=2,0

